#!/bin/bash
# exportRATmodel -- Export a 3D model of the current RAT-PAC experiment's geometry to VRML2 and (optionally) convert to X3D
# Notes:
# -- Run this script in the experiment directory (typically $GLG4DATA/<EXPERIMENT_NAME>; for example, "~/rat-pac/data/miniTimeCube/").
# ## -- Like RAT-PAC, this script assumes that the current directory contains either a macro or a symlink
# ##      located at "./prerun.mac", containing (or calling another macro containing) the /rat/db/set commands for "DETECTOR experiment"
# ##      and "DETECTOR geo_file". If such a "prerun.mac" is not present in your experiment's directory, use the "-p" option
# ##      to supply the location of such a macro.
# -- The X3D conversion is performed by the (open-source, multi-platform) program
#      "view3dscene" (https://castle-engine.sourceforge.io/view3dscene.php),
#      so this program is required if the conversion flag is set.
# -- Your installation of RAT-PAC must have VRML2 support; check your version's output for the line "VRML2FILE (VRML2FILE)" under
#      the line "Current available graphics systems are:".
# USAGE: exportRATmodel [-h|-x] 
# ~ Mark J. Duvall ~ duvall3.git@gmail.com ~ 06/2023 ~ #

