  Node1 -> Node4 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node4 [label="TKSMultiRes",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTKSMultiRes.html",tooltip="Class for combining reference-comparison results from multiple runs."];
  Node1 -> Node5 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node5 [label="TKSMultiRibbons",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTKSMultiRibbons.html",tooltip="Class for analyzing DeltaPhi for each individual angle alongside TKSMultiRes."];
  Node1 -> Node6 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node6 [label="TRATGeo",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTRATGeo.html",tooltip="class for assembling geometry in a RAT-PAC ROOT file"];
  Node1 -> Node7 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node7 [label="TRATGeoConverter",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTRATGeoConverter.html",tooltip="Class for converting geometry descriptions from RAT-PAC to GEANT4."];
  Node1 -> Node8 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node8 [label="TRATMaterial",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTRATMaterial.html",tooltip=" "];
  Node8 -> Node9 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node9 [label="TRATElement",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTRATElement.html",tooltip=" "];
  Node1 -> Node10 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node10 [label="TRATNeutronGen",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTRATNeutronGen.html",tooltip="Class for preparing sea-level muogenic fast neutrons:"];
  Node1 -> Node11 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node11 [label="TRATPACEventViewer",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTRATPACEventViewer.html",tooltip="Class for viewing RAT-PAC detector geometries and MC events in ROOT //DOC//."];
  Node1 -> Node12 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node12 [label="TRATTrackAnalyzer",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTRATTrackAnalyzer.html",tooltip="Class for processing data from RAT-PAC particle tracks."];
  Node1 -> Node13 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node13 [label="TRATVolume",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTRATVolume.html",tooltip="Class for analyzing geometry volumes from RAT-PAC ROOT file //DOC//...//."];
  Node1 -> Node14 [dir="back",color="midnightblue",fontsize="10",style="solid",fontname="Helvetica"];
  Node14 [label="TRefMatch",height=0.2,width=0.4,color="black", fillcolor="white", style="filled",URL="$classTRefMatch.html",tooltip="Class implementing KS/AD-test reference-matching algorithm. //DOC//."];
