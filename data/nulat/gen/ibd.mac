# ibd.mac -- IBD generator macro -- CENTRAL CUBE ONLY

/generator/add combo ibd:regexfill:poisson
#/generator/vtx/set 0 0 1
/generator/vtx/set -1 0 0 # neutrinos directed along -x direction
#/generator/pos/set 0 -9924 0
#/generator/pos/set 0 0 -9924
#/generator/pos/set target_cube
/generator/pos/set target_cube_mid_mid_mid
#/generator/rate/set 1
/generator/rate/set 1.11e-4 # using 27 * (1.e-1)**3 *( 2*cube->GetSize().X() * 2*cube->GetSize().Y() * 2*cube->GetSize().Z() ) * cube->IBDVolRate()

