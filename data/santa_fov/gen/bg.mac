# spectrum generator(s)
#/generator/add combo spectrum:paint:poisson
#/generator/vtx/set neutron nbg
#/generator/vtx/set neutron nbglog
#/generator/vtx/set neutron nbglin
#/generator/pos/set 3000. 3000. 3000. # paint the walls of the cave
#/generator/rate/set 173.35

# gun generator (for testing)
/generator/add combo gun:paint:poisson
/generator/vtx/set neutron 0 0 0 10 # isotropic 10-keV neutrons
/generator/pos/set 1100. 1100. 1100. # paint the walls of the cave
#/generator/rate/set 5.00e2 # 20mwe (smaller cave)
/generator/rate/set 1.0 # for testing w/ ibds

