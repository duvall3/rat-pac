# vertexfile generator
#/generator/add vertexfile bgNeutrons.root
#/generator/add vertexfile bgNeutrons.root:paint:poisson
#/generator/add vertexfile bgNeutrons.root:point:poisson
#/generator/pos/set 0.0 0.0 -3000. # paint the walls of the cave
/generator/add combo spectrum:paint:poisson
/generator/vtx/set neutron nbg
/generator/pos/set 3000. 3000. 3000. # paint the walls of the cave
/generator/rate/set 173.35
